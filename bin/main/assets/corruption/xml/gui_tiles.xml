<?xml version="1.0" encoding="UTF-8"?>
<!--
  The pieces of textures/gui/gui_tiles.png, read by GuiTiles. Positions and sizes are in pixels of that
  picture, whose own size is given on <tiles>.

  A tile named "bg_" + name is the empty look of the tile called name: GuiTiles.bar draws the empty one,
  then as much of the full one over it as the bar is filled. The two must be the same size.
-->
<tiles texture="corruption:textures/gui/gui_tiles.png" width="270" height="90">
    <tile name="bg_progress_bar" x="0" y="0" width="22" height="16"/>
    <tile name="progress_bar" x="0" y="16" width="22" height="16"/>
    <tile name="bg_loading_bar" x="22" y="0" width="14" height="14"/>
    <tile name="loading_bar" x="22" y="14" width="14" height="14"/>
    <tile name="bg_corruption_energy_bar" x="36" y="0" width="68" height="6"/>
    <tile name="corruption_energy_bar" x="36" y="6" width="68" height="6"/>
</tiles>
